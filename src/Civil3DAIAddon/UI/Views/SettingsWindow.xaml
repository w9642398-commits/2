<Window x:Class="Civil3DAIAddon.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Civil 3D - Settings"
        Width="500" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="#CDD6F4"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#89B4FA" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API Configuration -->
                <TextBlock Text="API Configuration" FontSize="14" FontWeight="SemiBold"
                           Foreground="#F9E2AF" Margin="0,0,0,8"/>

                <Label Content="OpenAI API Key"/>
                <PasswordBox x:Name="ApiKeyBox" Background="#313244" Foreground="#CDD6F4"
                             BorderBrush="#45475A" Padding="6,4"/>

                <Label Content="Primary Model (planning &amp; generation)"/>
                <TextBox Text="{Binding PrimaryModel}"/>

                <Label Content="Classification Model (intent routing)"/>
                <TextBox Text="{Binding ClassificationModel}"/>

                <StackPanel Orientation="Horizontal" Margin="0,8">
                    <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                            Padding="12,6" Background="#89B4FA" Foreground="#1E1E2E" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Foreground="#A6E3A1"/>
                </StackPanel>

                <!-- Execution Settings -->
                <TextBlock Text="Execution Settings" FontSize="14" FontWeight="SemiBold"
                           Foreground="#F9E2AF" Margin="0,16,0,8"/>

                <Label Content="Timeout (seconds)"/>
                <TextBox Text="{Binding TimeoutSeconds}"/>

                <Label Content="Max Tokens"/>
                <TextBox Text="{Binding MaxTokens}"/>

                <Label Content="Max Context Entities"/>
                <TextBox Text="{Binding MaxContextEntities}"/>

                <CheckBox Content="Dry Run by default" IsChecked="{Binding DryRunByDefault}"/>
                <CheckBox Content="Include viewport screenshot" IsChecked="{Binding IncludeScreenshot}"/>

                <Label Content="Confirmation Policy"/>
                <ComboBox SelectedItem="{Binding ConfirmationPolicy}" Background="#313244"
                          Foreground="#CDD6F4" BorderBrush="#45475A">
                    <ComboBoxItem Content="AlwaysConfirm"/>
                    <ComboBoxItem Content="ConfirmDestructive"/>
                    <ComboBoxItem Content="AutoExecute"/>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset Defaults" Command="{Binding ResetCommand}"
                    Padding="12,6" Background="#313244" Foreground="#CDD6F4" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Padding="20,6" Background="#89B4FA" Foreground="#1E1E2E"/>
        </StackPanel>
    </Grid>
</Window>
