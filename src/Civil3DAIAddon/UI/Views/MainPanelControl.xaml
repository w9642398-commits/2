<UserControl x:Class="Civil3DAIAddon.UI.Views.MainPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Civil3DAIAddon.UI.Converters"
             Background="#1E1E2E" Foreground="#CDD6F4">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <converters:ExecutionModeToStringConverter x:Key="ModeToString"/>

        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="AI Civil 3D Assistant" FontSize="16" FontWeight="SemiBold"
                           Foreground="#89B4FA" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentMode, Converter={StaticResource ModeToString}}"
                               Foreground="#A6E3A1" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#BAC2DE" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Context Bar -->
        <Border Grid.Row="1" Background="#11111B" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Scope:" Foreground="#6C7086" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedItem="{Binding CurrentScope}" Width="120" Margin="0,0,10,0">
                        <ComboBoxItem Content="Selection"/>
                        <ComboBoxItem Content="ModelSpace"/>
                        <ComboBoxItem Content="CurrentView"/>
                        <ComboBoxItem Content="AllDrawing"/>
                    </ComboBox>
                    <TextBlock Text="Mode:" Foreground="#6C7086" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedItem="{Binding CurrentMode}" Width="100">
                        <ComboBoxItem Content="DryRun"/>
                        <ComboBoxItem Content="Execute"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshContextCommand}"
                        Style="{StaticResource PanelButton}" Padding="8,2" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Main Content - Tab-like panels -->
        <TabControl Grid.Row="2" Background="#1E1E2E" BorderThickness="0"
                    SelectedIndex="0" Margin="0">

            <!-- Chat Panel -->
            <TabItem Header="Chat" Background="#313244" Foreground="#CDD6F4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Conversation History -->
                    <ListBox Grid.Row="0" ItemsSource="{Binding ConversationHistory}"
                             Background="#1E1E2E" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4" Margin="4,2"
                                        CornerRadius="6"
                                        MaxWidth="500" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="user">
                                                    <Setter Property="Background" Value="#45475A"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="system">
                                                    <Setter Property="Background" Value="#F38BA833"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}" FontSize="10" Foreground="#6C7086"/>
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#CDD6F4"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Streaming output -->
                    <Border Grid.Row="1" Background="#181825" Padding="6"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StreamingOutput}" TextWrapping="Wrap"
                                   Foreground="#A6E3A1" FontFamily="Consolas" FontSize="12"
                                   MaxHeight="100"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Plan Panel -->
            <TabItem Header="Plan" Background="#313244" Foreground="#CDD6F4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Current Execution Plan" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#89B4FA" Margin="0,0,0,8"
                                   Visibility="{Binding CurrentPlan, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding ExecutionSteps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#313244" CornerRadius="4" Padding="8" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding StepNumber}" Foreground="#6C7086"
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ToolName}" Foreground="#F9E2AF" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#BAC2DE" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="PENDING"/>
                                                        <Setter Property="Foreground" Value="#6C7086"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                                <Setter Property="Text" Value="OK"/>
                                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                                <Setter Property="Text" Value="FAIL"/>
                                                                <Setter Property="Foreground" Value="#F38BA8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Context Summary -->
            <TabItem Header="Context" Background="#313244" Foreground="#CDD6F4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Drawing Summary" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#89B4FA" Margin="0,0,0,6"/>
                        <Border Background="#313244" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DrawingSummary}" Foreground="#BAC2DE"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Selection Summary" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#89B4FA" Margin="0,0,0,6"/>
                        <Border Background="#313244" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SelectionSummary}" Foreground="#BAC2DE"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Safety Warnings" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F38BA8" Margin="0,0,0,6"/>
                        <Border Background="#313244" CornerRadius="4" Padding="8">
                            <TextBlock Text="{Binding SafetyWarnings}" Foreground="#F9E2AF"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Modified Objects -->
            <TabItem Header="Objects" Background="#313244" Foreground="#CDD6F4">
                <ListBox ItemsSource="{Binding ModifiedObjects}" Background="#1E1E2E"
                         Foreground="#CDD6F4" BorderThickness="0"/>
            </TabItem>

            <!-- Logs -->
            <TabItem Header="Logs" Background="#313244" Foreground="#CDD6F4">
                <ListBox ItemsSource="{Binding LogEntries}" Background="#1E1E2E" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#BAC2DE">
                                <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="#6C7086"/>
                                <Run Text=" ["/><Run Text="{Binding Level}"/><Run Text="] "/>
                                <Run Text="{Binding Message}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="#181825" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A"
                         Padding="8,6" FontSize="13" VerticalAlignment="Center"
                         AcceptsReturn="False" MinHeight="32"
                         ToolTip="Type your prompt here...">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button Content="Send" Command="{Binding SendCommand}" Style="{StaticResource AccentButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Bar -->
        <Border Grid.Row="4" Background="#11111B" Padding="6,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Confirm Plan" Command="{Binding ConfirmPlanCommand}"
                        Style="{StaticResource AccentButton}"/>
                <Button Content="Rollback" Command="{Binding RollbackCommand}"
                        Style="{StaticResource DangerButton}"/>
                <Button Content="Clear" Command="{Binding ClearChatCommand}"
                        Style="{StaticResource PanelButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
