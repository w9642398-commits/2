<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Civil3DAIAddon</RootNamespace>
    <AssemblyName>Civil3DAIAddon</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Authors>Civil3D AI Addon Team</Authors>
    <Description>AI-powered addon for Autodesk Civil 3D 2026</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD 2026 / Civil 3D 2026 references - adjust paths to your local install -->
    <Reference Include="accoremgd">
      <HintPath>$(Civil3DInstallPath)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(Civil3DInstallPath)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(Civil3DInstallPath)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="adwindows">
      <HintPath>$(Civil3DInstallPath)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccDbMgd">
      <HintPath>$(Civil3DInstallPath)\AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AeccUiMgd">
      <HintPath>$(Civil3DInstallPath)\AeccUiMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <Civil3DInstallPath Condition="'$(Civil3DInstallPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</Civil3DInstallPath>
  </PropertyGroup>

</Project>
